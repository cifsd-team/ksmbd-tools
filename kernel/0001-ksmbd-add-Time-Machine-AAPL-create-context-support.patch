+/*
+ * AAPL kAAPL_SERVER_QUERY response context.
+ *
+ * Observed from macOS's own smbd (via Mac-to-Mac capture):
+ *   reply_bitmap = 0x07  (echoes client's full request, incl. MODEL_INFO)
+ *   server_caps  = 0x1f  (READDIR_ATTR|COPYFILE|UNIX_BASED|NFS_ACE|0x10)
+ *   vol_caps     = 0x05  (RESOLVE_ID|FULL_SYNC)
+ *   model string present ("MacBookAir10,1")
+ *
+ * Sending reply_bitmap=0x03 without a model string causes smbfs.kext to
+ * take an incompletely initialised "Apple server" disconnect path that
+ * hard-freezes on unmount and requires a macOS reboot to recover.
+ *
+ * Fixed layout (56 bytes):
+ *   ccontext (16) + Name[4] + Pad[4] + cmd(4) + reserved(4) +
+ *   reply_bitmap(8) + server_caps(8) + vol_caps(8)
+ * When MODEL_INFO is included, these follow immediately:
+ *   pad2(4) + model_string_bytes(4) + UTF-16LE model string
+ */
+#define AAPL_SERVER_QUERY		1
+#define AAPL_BITMAP_SERVER_CAPS		0x01ULL
+#define AAPL_BITMAP_VOL_CAPS		0x02ULL
+#define AAPL_BITMAP_MODEL_INFO		0x04ULL
+
+/* Server capability flags */
+#define AAPL_CAPS_READDIR_ATTR		0x01ULL  /* bulk dir attr — not implemented */
+#define AAPL_CAPS_COPYFILE		0x02ULL  /* macOS copyfile */
+#define AAPL_CAPS_UNIX_BASED		0x04ULL  /* server is Unix-based */
+#define AAPL_CAPS_NFS_ACE		0x08ULL  /* NFS ACE ownership — not fully implemented */
+
+/*
+ * Capabilities we actually advertise.  Advertising NFS_ACE or READDIR_ATTR
+ * without implementing them causes macOS to set UNIX ACEs and read extended
+ * directory info in ways ksmbd doesn't support, resulting in wrong file
+ * permissions.  UNIX_BASED is truthful and harmless.
+ */
+#define AAPL_SERVER_CAPS_KSMBD		AAPL_CAPS_UNIX_BASED
+
+/* Volume capability flags */
+#define AAPL_VOLCAPS_RESOLVE_ID		0x01ULL
+#define AAPL_VOLCAPS_FULL_SYNC		0x04ULL
+
+/* UTF-16LE "Samba" model string: 5 chars × 2 bytes */
+#define AAPL_MODEL_UTF16_BYTES		10
+
+/*
+ * Maximum AAPL response size: fixed struct + pad2(4) + model_bytes(4) +
+ * model string (10), 8-byte aligned: ALIGN(56+18, 8) = 80.
+ */
+#define AAPL_RSP_MAX_SIZE		80
+
+struct create_aapl_rsp {
+	struct create_context ccontext;
+	__u8   Name[4];
+	__u8   Pad[4];
+	__le32 cmd;
+	__le32 reserved;
+	__le64 reply_bitmap;
+	__le64 server_caps;
+	__le64 vol_caps;
+	/* When AAPL_BITMAP_MODEL_INFO in reply_bitmap, appended after: */
+	/* __le32 pad2; __le32 model_string_bytes; __le16 model[]; */
+} __packed;
