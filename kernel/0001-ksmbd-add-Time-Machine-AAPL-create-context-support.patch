+/**
+ * create_aapl_rsp_buf() - build Apple AAPL kAAPL_SERVER_QUERY response context
+ * @cc:       buffer to write the create context into
+ * @vol_caps: volume capability flags to advertise (AAPL_VOLCAPS_*)
+ *
+ * Wire format per Apple "Time Machine Over SMB" specification.
+ * ServerCapabilities is always 0 ("reserved for future use" per spec).
+ * ReplyBitmap always includes SERVER_CAPS and VOL_CAPS; MODEL_INFO is
+ * never set in the server reply.
+ */
+void create_aapl_rsp_buf(char *cc, __u64 vol_caps)
+{
+	struct create_aapl_rsp *buf;
+
+	buf = (struct create_aapl_rsp *)cc;
+	memset(buf, 0, sizeof(struct create_aapl_rsp));
+	buf->ccontext.DataOffset = cpu_to_le16(offsetof(struct create_aapl_rsp, cmd));
+	buf->ccontext.DataLength = cpu_to_le32(32);
+	buf->ccontext.NameOffset = cpu_to_le16(offsetof(struct create_aapl_rsp, Name));
+	buf->ccontext.NameLength = cpu_to_le16(4);
+	buf->Name[0] = 'A';
+	buf->Name[1] = 'A';
+	buf->Name[2] = 'P';
+	buf->Name[3] = 'L';
+
+	buf->cmd          = cpu_to_le32(AAPL_SERVER_QUERY);
+	buf->reply_bitmap = cpu_to_le64(AAPL_BITMAP_SERVER_CAPS | AAPL_BITMAP_VOL_CAPS);
+	buf->server_caps  = 0; /* reserved per spec */
+	buf->vol_caps     = cpu_to_le64(vol_caps);
+}
