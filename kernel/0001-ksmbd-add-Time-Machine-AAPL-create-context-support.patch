+/*
+ * Detach the first suspended durable fp from ci->m_fp_list.
+ * Called with ci->m_lock held (write). Returns the fp to free (or NULL)
+ * and stores its filp in *filp_out. Caller must invoke
+ * __free_suspended_fp() after releasing ci->m_lock.
