+#define AAPL_SERVER_CAPS_KSMBD		AAPL_CAPS_COPYFILE
+
+/* Volume capability flags */
+#define AAPL_VOLCAPS_RESOLVE_ID		0x01ULL  /* kAAPL_RESOLVE_ID supported */
+#define AAPL_VOLCAPS_FULL_SYNC		0x04ULL  /* SMB2 FLUSH = F_FULLFSYNC */
