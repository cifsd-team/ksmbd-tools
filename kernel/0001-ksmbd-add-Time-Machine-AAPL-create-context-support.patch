+struct aapl_resolve_id_req {
+	__le32	cmd;		/* AAPL_RESOLVE_ID */
+	__le32	reserved;
+	__le64	node_id;	/* inode/node ID to resolve */
+} __packed;
+
+/* AAPL kAAPL_RESOLVE_ID response: cmd(4)+reserved(4)+status(4)+pad(4)+path */
+struct aapl_resolve_id_rsp {
+	__le32	cmd;
+	__le32	reserved;
+	__le32	nt_status;
+	__le32	pad;
+	/* UTF-16LE path follows (null-terminated) */
