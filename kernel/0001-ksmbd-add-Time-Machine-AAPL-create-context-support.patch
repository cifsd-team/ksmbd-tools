+/*
+ * AAPL kAAPL_SERVER_QUERY response context.
+ * Wire format per Apple "Time Machine Over SMB" specification.
+ *
+ * Layout (56 bytes total, __packed):
+ *   ccontext  : 16  (create_context header)
+ *   Name[4]   :  4  "AAPL"
+ *   Pad[4]    :  4  align data to 8 bytes
+ *   cmd       :  4  kAAPL_SERVER_QUERY = 1
+ *   reserved  :  4
+ *   reply_bitmap : 8
+ *   server_caps  : 8  reserved, always 0
+ *   vol_caps     : 8  AAPL_VOLCAPS_FULL_SYNC when supported
+ */
+#define AAPL_SERVER_QUERY		1
+#define AAPL_BITMAP_SERVER_CAPS		0x01ULL
+#define AAPL_BITMAP_VOL_CAPS		0x02ULL
+#define AAPL_VOLCAPS_FULL_SYNC		0x04ULL
+
+struct create_aapl_rsp {
+	struct create_context ccontext;
+	__u8   Name[4];
+	__u8   Pad[4];
+	__le32 cmd;
+	__le32 reserved;
+	__le64 reply_bitmap;
+	__le64 server_caps;
+	__le64 vol_caps;
+} __packed;
